# Copy this file to ".env" and fill it in. Never share your .env file.

# Your business name, shown on every page and in the Chrome button.
COMPANY_NAME=My Company
# Your website. The signature picture under each video links here. Optional.
COMPANY_URL=https://www.example.com/
# The public https address people will open your videos at.
PUBLIC_URL=https://video.example.com

# Email alerts ("Sam watched your video"). A Gmail address and a Gmail *app password*
# (not your normal password). Leave empty to switch email alerts off.
SMTP_USER=
SMTP_PASSWORD=

# How much disk the videos may use before old unwatched ones are cleared.
STORAGE_LIMIT_GB=12

# Texting from a business number through Telnyx. Optional; leave off unless you have
# a Telnyx account and an approved texting registration.
TEXTING_ENABLED=0
TELNYX_API_KEY=
TEXT_FROM=
