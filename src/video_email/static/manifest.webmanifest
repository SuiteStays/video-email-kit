{
  "name": "__COMPANY__ Video",
  "short_name": "Video",
  "id": "/app",
  "start_url": "/app#/record",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f7fa",
  "theme_color": "#0f5c8c",
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Record", "url": "/app#/record", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "Activity", "url": "/app#/activity", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] },
    { "name": "My videos", "url": "/app#/", "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "video", "accept": ["video/*"] }] }
  }
}
